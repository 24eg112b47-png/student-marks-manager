{
  "name": "student-marks-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --config client/vite.config.mjs",
    "java:build": "javac -d java/build java/src/StudentCalculator.java",
    "build": "npm run java:build && vite build --config client/vite.config.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "npm run java:build && node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}